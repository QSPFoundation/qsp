// Ported from qsp-wasm-engine tests/engine/time.test.ts

@test WAIT should trigger wait event
@src
WAIT 1000
@run
@expect-event wait 1000

// WAIT refreshes the UI with isRedraw on, so every window is reported
@test WAIT should pause execution
@src
pl 'before wait' & WAIT 1000 & p 'after wait'
@run
@expect-event stats_changed before wait\r\n
@expect-event wait 1000
@expect-event stats_changed before wait\r\nafter wait

// @clock sets the time of the host, it starts at 0 with the test like the time of the engine
@test MSECSCOUNT should return msec passed from game start
@src
res = MSECSCOUNT
@run
@expect res => 0
@clock 2000
@exec res = MSECSCOUNT
@expect res => 2000

@test MSECSCOUNT: the time doesn't go on between two reads with the same clock
@clock 2000
@exec first = MSECSCOUNT & second = MSECSCOUNT
@expect first => 2000
@expect second => 2000
@clock 4500
@exec third = MSECSCOUNT
@expect third => 4500

@test MSECSCOUNT: the restart counts from zero
@src
res = MSECSCOUNT
@run
@clock 3000
@exec res = MSECSCOUNT
@expect res => 3000
@restart
@clock 3700
@exec res = MSECSCOUNT
@expect res => 700

@test SETTIMER should change counter frequency
@src
SETTIMER 100
@run
@expect-event timer 100

@test counter location should be called
@src

$counter = 'counter'
---
#counter
p 'works'

@run
@counter
@expect-event stats_changed works
@counter
@expect-event stats_changed worksworks

@test several counters should be supported
@src

$counter = 'counter'
$counter[] = 'counter_other'
---
#counter
p 'works'
--
#counter_other
p ' & works other'

@run
@counter
@expect-event stats_changed works & works other
