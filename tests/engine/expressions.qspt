@test &: string contenations
@src
$res = ('a' & 'b')
@run
@expect $res => 'ab'

// wasm: readVariable('res') is 12; since d938a28 a variable without a prefix keeps the type of the
// value, so "res" holds the string '12' (the numeric view of it is 0)
@test &: number are convered to string and concatenated
@src
res = (1 & 2)
@run
@expect res => '12'
@expect #res => 0

@test NO (3 = 2) = 1
@src
res = NO (3 = 2)
@run
@expect res => 1

@test NO (2 = 2) = 0
@src
res = NO (2 = 2)
@run
@expect res => 0

@test AND: (2 = 2) AND (3 <> 2) = 1
@src
res = (2 = 2) AND (3 <> 2)
@run
@expect res => 1

@test AND: (3 <> 2) AND (2 = 2) = 1
@src
res = (3 <> 2) AND (2 = 2)
@run
@expect res => 1

@test AND: (2 <> 2) AND (3 <> 2) = 0
@src
res = (2 <> 2) AND (3 <> 2)
@run
@expect res => 0

@test AND: (2 <> 2) AND (3 = 2) = 0
@src
res = (2 <> 2) AND (3 = 2)
@run
@expect res => 0

@test OR: (2 = 2) OR (3 <> 2) = 1
@src
res = (2 = 2) OR (3 <> 2)
@run
@expect res => 1

@test OR: (3 <> 2) OR (2 = 2) = 1
@src
res = (3 <> 2) OR (2 = 2)
@run
@expect res => 1

@test OR: (2 <> 2) OR (3 <> 2) = 1
@src
res = (2 <> 2) OR (3 <> 2)
@run
@expect res => 1

@test OR: (2 <> 2) OR (3 = 2) = 0
@src
res = (2 <> 2) OR (3 = 2)
@run
@expect res => 0

@test LOC should return 1 if location exists
@src
res = LOC('test')
@run
@expect res => 1

@test LOC should return 0 if location does exists
@src
res = LOC('unknown')
@run
@expect res => 0

@test OBJ should return 1 if object exists
@src
addobj 'test' & res = OBJ('test')
@run
@expect res => 1

@test OBJ should return 0 if object does exists
@src
res = OBJ('unknown')
@run
@expect res => 0

@test MOD: 4 MOD 2 = 0
@src
res = (4 MOD 2)
@run
@expect res => 0

@test MOD: 5 MOD 2 = 1
@src
res = (5 MOD 2)
@run
@expect res => 1

@test MOD: -7 MOD 5 = -2
@src
res = (-7 MOD 5)
@run
@expect res => -2

@test MOD: 7 MOD -5 = 2
@src
res = (7 MOD -5)
@run
@expect res => 2

@test MOD: -7 MOD -5 = -2
@src
res = (-7 MOD -5)
@run
@expect res => -2

@test priorities: same level priority
@src
res = 15*5/2
        res2 = 15/2*5
@run
@expect res => 37
@expect res2 => 35

@test priorities: multi level priorities
@src
x = 5 & y = 6 & res = x*y + y*-x/2
@run
@expect res => 15

@test priorities: OBJ priority
@src
res = OBJ '1' = OBJ '2'
@run
@expect res => 1
@exec addobj '1' & res = OBJ '1' = OBJ '2'
@expect res => 0
@exec addobj '2' & res = OBJ '1' = OBJ '2'
@expect res => 1

@test priorities: LOC priority
@src

  first = LOC 'other' = LOC 'another'
  second = LOC 'start' = LOC 'another'
  third = LOC 'start' = LOC 'test'

@run
@expect first => 1
@expect second => 0
@expect third => 1
