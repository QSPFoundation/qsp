// Ported from qsp-wasm-engine tests/engine/expressions.test.ts

@test *: 2 * 4 = 8
@src
res = 2 * 4
@run
@expect res => 8

@test *: -2 * 4 = -8
@src
res = -2 * 4
@run
@expect res => -8

@test *: -2 * -4 = 8
@src
res = -2 * -4
@run
@expect res => 8

@test *: 0 * 2 = 0
@src
res = 0 * 2
@run
@expect res => 0

@test *: -2 * 0 = 0
@src
res = -2 * 0
@run
@expect res => 0

@test *: 0 * 0 = 0
@src
res = 0 * 0
@run
@expect res => 0

@test *: 1 * 3 = 3
@src
res = 1 * 3
@run
@expect res => 3

@test *=: res *= 2 -> 4
@src
res = 2 & res *= 2
@run
@expect res => 4

@test *=: res *= -2 -> -4
@src
res = 2 & res *= -2
@run
@expect res => -4

@test *=: res *= 0 -> 0
@src
res = 2 & res *= 0
@run
@expect res => 0

@test *=: res *= 1 -> 2
@src
res = 2 & res *= 1
@run
@expect res => 2

@test +: 2 + 2 = 4
@src
res = 2 + 2
@run
@expect res => 4

@test +: -2 + 2 = 0
@src
res = -2 + 2
@run
@expect res => 0

@test +: -2 + -2 = -4
@src
res = -2 + -2
@run
@expect res => -4

@test +: 0 + 2 = 2
@src
res = 0 + 2
@run
@expect res => 2

@test +: -2 + 0 = -2
@src
res = -2 + 0
@run
@expect res => -2

@test +: 0 + 0 = 0
@src
res = 0 + 0
@run
@expect res => 0

@test +: 1 + 3 = 4
@src
res = 1 + 3
@run
@expect res => 4

@test + acts as concatenations for strings
@src
$res = 'a' + 'b'
@run
@expect $res => 'ab'

@test + acts as concatenations for strings with numbers
@src
$res = '1' + '2'
@run
@expect $res => '12'

@test +: if string is convertable to number - number is returned
@src

          res = 1 + '2'
          res2 = '1' + 2

@run
@expect res => 3
@expect $res => ''
@expect res2 => 3
@expect $res2 => ''

@test +: if string is not convertable to number - string is returned
@src
$res = 1 + '2a'
@run
@expect #res => 0
@expect $res => '12a'

@test +=: res += 2 -> 4
@src
res = 2 & res += 2
@run
@expect res => 4

@test +=: res += -2 -> 0
@src
res = 2 & res += -2
@run
@expect res => 0

@test +=: res += 0 -> 2
@src
res = 2 & res += 0
@run
@expect res => 2

@test +=: res += 1 -> 3
@src
res = 2 & res += 1
@run
@expect res => 3

@test +=: it acts as concatenation for strings
@src
$res = 'a'
        $res += 'b'
@run
@expect $res => 'ab'

@test -: 2 - 2 = 0
@src
res = 2 - 2
@run
@expect res => 0

@test -: -2 - 2 = -4
@src
res = -2 - 2
@run
@expect res => -4

@test -: -2 - -2 = 0
@src
res = -2 - -2
@run
@expect res => 0

@test -: 0 - 2 = -2
@src
res = 0 - 2
@run
@expect res => -2

@test -: -2 - 0 = -2
@src
res = -2 - 0
@run
@expect res => -2

@test -: 0 - 0 = 0
@src
res = 0 - 0
@run
@expect res => 0

@test -: 1 - 3 = -2
@src
res = 1 - 3
@run
@expect res => -2

@test -: if string can be converted to number - it gets subtracted
@src

        res = '2' - '1'
        res2 = 2 - '1'
        res3 = '2' - 1

@run
@expect res => 1
@expect res2 => 1
@expect res3 => 1

@test -: if string cannot be converted to number - error is shown
@src
res = '2a' - '1'
@run
@expect error TYPEMISMATCH (location 'test', line 1, local 1, action -1) RES = '2a' - '1'

@test -=: res -= 2 -> 0
@src
res = 2 & res -= 2
@run
@expect res => 0

@test -=: res -= -2 -> 4
@src
res = 2 & res -= -2
@run
@expect res => 4

@test -=: res -= 0 -> 2
@src
res = 2 & res -= 0
@run
@expect res => 2

@test -=: res -= 1 -> 1
@src
res = 2 & res -= 1
@run
@expect res => 1

@test unary minus: -2 = -2
@src
res = -2
@run
@expect res => -2

@test unary minus: --2 = 2
@src
res = --2
@run
@expect res => 2

@test unary minus: -0 = 0
@src
res = -0
@run
@expect res => 0

@test unary minus: it should negate group result
@src
res = -(3 + 6) & res2 = -(-3)
@run
@expect res => -9
@expect res2 => 3

@test unary minus: it coverts and negates string
@src
res = -'2'
@run
@expect res => -2

@test unary minus: error should be shown if string cannot be converted to number
@src
res = -'2a'
@run
@expect error TYPEMISMATCH (location 'test', line 1, local 1, action -1) RES = -'2a'

@test /: 2 / 2 = 1
@src
res = 2 / 2
@run
@expect res => 1

@test /: 4 / 2 = 2
@src
res = 4 / 2
@run
@expect res => 2

@test /: -4 / 2 = -2
@src
res = -4 / 2
@run
@expect res => -2

@test /: -4 / -2 = 2
@src
res = -4 / -2
@run
@expect res => 2

@test /: 17 / 3 = 5
@src
res = 17 / 3
@run
@expect res => 5

@test /: 37 / 100 = 0
@src
res = 37 / 100
@run
@expect res => 0

@test /: strings are converted to numbers
@src
res = '2' / '1'
@run
@expect res => 2

@test /: if string cannot be converted to number - error is shown
@src
res = '2a' / '1'
@run
@expect error TYPEMISMATCH (location 'test', line 1, local 1, action -1) RES = '2a' / '1'

@test /: error on zero division
@src
res = 2 / 0
@run
@expect error DIVBYZERO (location 'test', line 1, local 1, action -1) RES = 2 / 0

@test /=: res /= 2 -> 2
@src
res = 4 & res /= 2
@run
@expect res => 2

@test /=: res /= 4 -> 1
@src
res = 4 & res /= 4
@run
@expect res => 1

@test /=: res /= 37 -> 0
@src
res = 4 & res /= 37
@run
@expect res => 0

