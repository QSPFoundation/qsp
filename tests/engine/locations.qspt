// Ported from qsp-wasm-engine tests/engine/locations.test.ts
// runTestFileWithGoto() of qsp-wasm-engine is "@exec gt 'test'" here

@test GOTO should change locations
@src

*p 'main'
p 'stats'
$location = $curloc
act '1': x
---
# target
*p 'target main'
nl 'target stats'
act '2': x
$gt_location = $curloc

@exec gt 'test'
@expect event main_changed main
@expect event stats_changed stats
@expect event actions_changed [1]
@expect $location => 'test'
@exec GOTO 'target', 1, 'test'
@expect event main_changed target main
@expect event stats_changed stats\r\ntarget stats
@expect event actions_changed [2]
@expect args[0] => 1
@expect $args[1] => 'test'
@expect $gt_location => 'target'

